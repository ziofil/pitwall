<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pitwall</AssemblyName>
    <!-- Released as standalone executables on GitHub, not as a NuGet package -->
    <IsPackable>false</IsPackable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="InhibitSleep.Net" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SharpWebview.Aot" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Vezel.Cathode" />
    <PackageReference Include="Vezel.Cathode.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../gen/Pitwall.Console.SourceGeneration/Pitwall.Console.SourceGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <ProjectReference Include="..\Pitwall.Data\Pitwall.Data.csproj" />
  </ItemGroup>
  <ItemGroup></ItemGroup>
  <Target
    Name="OverrideVersion"
    AfterTargets="GetBuildVersion"
    Condition="'$(OverridePackageVersion)' != ''"
  >
    <PropertyGroup>
      <PackageVersion>$(OverridePackageVersion)</PackageVersion>
      <AssemblyVersion>$(OverridePackageVersion)</AssemblyVersion>
      <AssemblyInformationalVersion>$(OverridePackageVersion)</AssemblyInformationalVersion>
      <FileVersion>$(OverridePackageVersion)</FileVersion>
      <InformationalVersion>$(OverridePackageVersion)</InformationalVersion>
      <NugetPackageVersion>$(OverridePackageVersion)</NugetPackageVersion>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Pitwall.Console.Tests" />
  </ItemGroup>
</Project>
