{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "Launch Main App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Pitwall.Console/bin/Debug/net9.0/pitwall.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Pitwall.Console/",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Output Image",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Pitwall.Console/bin/Debug/net9.0/pitwall.dll",
      "args": ["image", "${input:filepath}", "${input:protocol}"],
      "cwd": "${workspaceFolder}/Pitwall.Console/",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "filepath",
      "description": "The filepath to load",
      "type": "promptString"
    },
    {
      "id": "protocol",
      "description": "The graphics protocol to use",
      "type": "promptString"
    }
  ]
}
